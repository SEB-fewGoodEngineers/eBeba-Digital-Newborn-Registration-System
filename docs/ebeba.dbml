// eBeba – Digital Newborn Registration
// Data model for the Nov 16–19 sprint. Paste into dbdiagram.io.
//
// How to read this file:
// - Table names = MongoDB collection names (set with { collection: "..." } in each Mongoose model).
// - Every collection also has createdAt and updatedAt from { timestamps: true }.
// - "objectid" = MongoDB ObjectId.
// - Tables whose note starts with EMBEDDED are subdocuments or arrays inside another
//   document, not collections. They are drawn as tables only so the links show.
// - Enum values match server/constants/index.js exactly.
// - All data is synthetic. JMBGs and card numbers use a DEMO format.

Project ebeba {
  database_type: 'MongoDB'
  Note: '''
  eBeba sprint data model. 16 collections, Mongoose 8.
  Unique fields that start empty (jmbg, card numbers) have NO default value:
  a null value would break the unique index for the second document.
  '''
}

// ───────────────────────── Enums ─────────────────────────

Enum role {
  admin
  hospital_staff
  moi_staff
  csw_staff
  health_insurance_staff
  pediatrician
  parent
}

Enum institution_type {
  hospital
  moi
  csw
  health_insurance_fund
  pediatric_clinic
}

Enum gender {
  M
  F
}

Enum family_type {
  two_parents
  single_parent
  unknown_father
  legal_guardian
}

Enum registration_status {
  pending
  returned [note: 'Returned for correction; the parent edits and resubmits']
  approved
  rejected [note: 'Final in the demo']
}

Enum csw_case_status {
  received
  in_progress
  completed [note: 'Social card number issued']
  rejected
}

Enum insurance_status {
  received
  in_progress
  card_issued
}

Enum entry_source {
  "parent-entered"
  "pediatrician-entered"
}

Enum medical_record_type {
  examination
  allergy
  general_note
}

Enum appointment_status {
  upcoming
  completed
  cancelled
}

Enum diary_category {
  feeding
  sleep
  diaper
  temperature
  activity
}

Enum feeding_method {
  breastfeeding
  bottle
  solid
}

Enum diaper_type {
  wet
  dirty
  both
}

Enum milestone_category {
  motor
  cognitive
  social
  language
}

Enum ai_suggestion_kind {
  registration_precheck
}

Enum ai_flag_source {
  rule [note: 'From the rule-based check, no AI']
  ai
}

Enum ai_flag_decision {
  pending
  accepted
  dismissed
}

// ───────────────────── Platform: Auth, access and audit ─────────────────────

Table institutions [note: 'Owner: Auth service. Created by the seed script.'] {
  _id objectid [pk]
  name string [not null, note: 'Fictional, e.g. "Opšta bolnica Primorje"']
  type institution_type [not null]
  code string [not null, unique, note: 'e.g. "HOSP-PG-01"; used in birth record numbers']
  municipality string [not null, note: 'Used to route CSW cases and FZO records']
  address string [not null]
  contactPhone string
  contactEmail string
  isActive boolean [not null, default: true]
  createdAt date
  updatedAt date
}

Table users [note: 'Owner: Auth service. toJSON removes hashedPassword. Public sign-up always creates role "parent".'] {
  _id objectid [pk]
  firstName string [not null, note: 'max 50']
  lastName string [not null, note: 'max 50']
  email string [not null, unique, note: 'Lowercase. Parents link to a birth record with this email.']
  hashedPassword string [note: 'Required unless googleId is set']
  googleId string [unique, note: 'Optional, sparse index, no default. Google sign-in is demo-only.']
  phoneNumber string
  role role [not null]
  institutionId objectid [ref: > institutions._id, note: 'Required for staff roles and pediatrician; must match the role (see ROLE_INSTITUTION_TYPE)']
  isActive boolean [not null, default: true, note: 'false = signed out on the next request']
  createdAt date
  updatedAt date
}

Table auditLogs [note: 'Owner: Auth service. Append-only: no route updates or deletes entries.'] {
  _id objectid [pk]
  actorUserId objectid [not null, ref: > users._id]
  actorRole role [not null, note: 'Copied at the time of the action']
  action string [not null, note: 'e.g. "diary_entry.create", "registration.approve", "ai_flag.dismiss"']
  targetCollection string [not null, note: 'e.g. "registrations"']
  targetDocumentId objectid [not null, note: 'Any collection, so no foreign key']
  changes json [note: '{ before, after }']
  createdAt date

  Indexes {
    (targetCollection, targetDocumentId)
    createdAt
  }
}

// ───────────────────── Epic 1: Hospital and birth records ─────────────────────

Table babies [note: 'Owner: Epic 1. The birth record, created by hospital staff. Fields marked "on approval" are written only by the workflow service.'] {
  _id objectid [pk]
  birthRecordNumber string [not null, unique, note: 'Generated by the server, e.g. "BR-HOSP-PG-01-7K3F9". The parent types it to link.']
  hospitalId objectid [not null, ref: > institutions._id, note: 'From req.user.institutionId, never from the form']
  createdByUserId objectid [not null, ref: > users._id]
  gender gender [not null]
  birthDateTime date [not null]
  placeOfBirth string [not null]
  municipalityOfBirth string [not null]
  birthWeightGrams int
  birthLengthCm decimal
  familyType family_type [not null]
  mother parent_info [not null, note: 'EMBEDDED parent_info']
  father parent_info [note: 'EMBEDDED parent_info. Left out for single_parent and unknown_father.']
  authorizedUserIds array [not null, default: `[]`, note: 'EMBEDDED baby_authorized_users: user ids of linked parents or guardians']
  firstName string [note: 'On approval, copied from registrations.proposedFirstName']
  lastName string [note: 'On approval']
  residentialAddress string [note: 'On approval']
  jmbg string [unique, note: 'On approval. DEMO format. Sparse index, NO default (null breaks the unique index).']
  registeredAt date [note: 'On approval']
  assignedPediatricianId objectid [ref: > users._id, note: 'Set by FZO staff (story 3.5). The only place the pediatrician is stored.']
  createdAt date
  updatedAt date

  Indexes {
    (hospitalId, createdAt) [note: 'Hospital birth list, newest first']
    authorizedUserIds [note: 'A parent\'s babies']
    assignedPediatricianId [note: 'Pediatrician roster']
  }
}

Table parent_info [note: 'EMBEDDED in babies.mother and babies.father (Mongoose sub-schema with { _id: false }). Not a collection.'] {
  firstName string [not null]
  lastName string [not null]
  maidenName string [note: 'Mother only']
  dateOfBirth date
  jmbg string [note: 'DEMO format']
  citizenship string [default: 'Montenegrin']
  address string
  email string [not null, note: 'Lowercase. Linking (story 1.2) needs this to match the parent\'s login email.']
}

Table baby_authorized_users [note: 'EMBEDDED array babies.authorizedUserIds. Not a collection. Filled by linking (story 1.2) or by the seed script for the legal guardian.'] {
  babyId objectid [ref: > babies._id, note: 'The baby document that holds the array']
  userId objectid [not null, ref: > users._id, note: 'A user with role "parent"']
}

// ───────────────────── Epic 2 + Workflow: Registration and MoI ─────────────────────

Table registrations [note: 'Owner: Epic 2. One application per baby. Status changes only through workflow.transition().'] {
  _id objectid [pk]
  babyId objectid [not null, unique, ref: - babies._id, note: 'One per baby: a rejection is final']
  submittedByUserId objectid [not null, ref: > users._id]
  proposedFirstName string [not null]
  proposedLastName string [not null]
  residentialAddress string [not null]
  municipality string [not null, note: 'Routes the CSW case and FZO record']
  status registration_status [not null, default: 'pending']
  reviewerNotes string [note: 'Required when returned or rejected']
  reviewedByUserId objectid [ref: > users._id, note: 'MoI staff']
  reviewedAt date
  statusHistory array [not null, default: `[]`, note: 'EMBEDDED status_change']
  createdAt date
  updatedAt date

  Indexes {
    (status, createdAt) [note: 'MoI queue: pending, oldest first']
  }
}

Table status_change [note: 'EMBEDDED in registrations, cswCases and insuranceRecords (statusHistory). Written only by workflow.transition(). Not a collection.'] {
  from string [note: 'Empty for the first entry']
  to string [not null]
  byUserId objectid [not null, ref: > users._id]
  at date [not null]
  note string
}

// ───────────────────── Epic 3: CSW and FZO ─────────────────────

Table cswCases [note: 'Owner: Epic 3. Created by workflow.approveRegistration(), never before approval. No record = "Waiting for MoI" on the dashboard.'] {
  _id objectid [pk]
  babyId objectid [not null, unique, ref: - babies._id, note: 'One per baby, so approval can safely run twice']
  registrationId objectid [not null, ref: - registrations._id]
  cswInstitutionId objectid [not null, ref: > institutions._id, note: 'Same municipality as the registration; otherwise the first active CSW']
  status csw_case_status [not null, default: 'received']
  socialCardNumber string [unique, note: 'Set on completed. DEMO format. Sparse, no default.']
  notes string
  processedByUserId objectid [ref: > users._id]
  completedAt date
  statusHistory array [not null, default: `[]`, note: 'EMBEDDED status_change']
  createdAt date
  updatedAt date

  Indexes {
    (cswInstitutionId, status) [note: 'CSW case list']
  }
}

Table insuranceRecords [note: 'Owner: Epic 3. Created by workflow.approveRegistration(), never before approval.'] {
  _id objectid [pk]
  babyId objectid [not null, unique, ref: - babies._id]
  registrationId objectid [not null, ref: - registrations._id]
  fundBranchId objectid [not null, ref: > institutions._id, note: 'Same municipality rule as CSW']
  insuredParentId objectid [ref: > users._id, note: 'Chosen from babies.authorizedUserIds (story 3.4)']
  status insurance_status [not null, default: 'received']
  policyNumber string [unique, note: 'Set on card_issued. DEMO. Sparse, no default.']
  healthCardNumber string [unique, note: 'Set on card_issued. DEMO. Sparse, no default.']
  insuredPersonCardNumber string [unique, note: 'Set on card_issued. DEMO. Sparse, no default.']
  cardIssuedAt date
  processedByUserId objectid [ref: > users._id]
  statusHistory array [not null, default: `[]`, note: 'EMBEDDED status_change']
  createdAt date
  updatedAt date

  Indexes {
    (fundBranchId, status) [note: 'FZO record list']
  }
}

// ───────────────────── Epic 4: Dashboard, BabyHealth, pediatrician ─────────────────────

Table medicalRecords [note: 'Owner: Epic 4. Parents cannot edit pediatrician-entered records, and pediatricians cannot edit parent-entered ones.'] {
  _id objectid [pk]
  babyId objectid [not null, ref: > babies._id]
  recordType medical_record_type [not null]
  title string [not null]
  description string [not null]
  doctorRecommendations string
  entrySource entry_source [not null, note: 'Set by the server from req.user.role']
  authorUserId objectid [not null, ref: > users._id]
  examinationDate date [not null]
  createdAt date
  updatedAt date

  Indexes {
    (babyId, examinationDate)
  }
}

Table vaccinations [note: 'Owner: Epic 4. "Overdue" is not stored: scheduledDate passed and no administeredDate.'] {
  _id objectid [pk]
  babyId objectid [not null, ref: > babies._id]
  vaccineName string [not null]
  doseNumber int [not null, default: 1]
  scheduledDate date [not null]
  administeredDate date
  entrySource entry_source [not null]
  authorUserId objectid [not null, ref: > users._id]
  reminderSent boolean [not null, default: false, note: 'Set by the reminder job']
  notes string
  createdAt date
  updatedAt date

  Indexes {
    (babyId, scheduledDate)
    (reminderSent, scheduledDate) [note: 'Reminder job']
  }
}

Table appointments [note: 'Owner: Epic 4. Fictional check-ups only.'] {
  _id objectid [pk]
  babyId objectid [not null, ref: > babies._id]
  title string [not null]
  scheduledAt date [not null]
  location string
  status appointment_status [not null, default: 'upcoming']
  createdByUserId objectid [not null, ref: > users._id]
  reminderSent boolean [not null, default: false]
  notes string
  createdAt date
  updatedAt date

  Indexes {
    (babyId, scheduledAt)
    (reminderSent, scheduledAt) [note: 'Reminder job']
  }
}

// ───────────────────── Epic 5: BabyCare and BabySteps (starter epic) ─────────────────────

Table diaryEntries [note: 'Owner: Epic 5. Only the details fields for the chosen category are filled.'] {
  _id objectid [pk]
  babyId objectid [not null, ref: > babies._id]
  loggedByUserId objectid [not null, ref: > users._id, note: 'From req.user, never from the form']
  category diary_category [not null]
  recordedAt date [not null, note: 'Sent by the browser as ISO']
  details_method feeding_method [note: 'details.method – feeding only']
  details_amountMl int [note: 'details.amountMl – feeding only']
  details_durationMinutes int [note: 'details.durationMinutes – sleep only']
  details_diaperType diaper_type [note: 'details.diaperType – diaper only']
  details_temperatureCelsius decimal [note: 'details.temperatureCelsius – temperature only']
  notes string [note: 'max 500. The only field for "activity"']
  createdAt date
  updatedAt date

  Indexes {
    (babyId, recordedAt) [note: 'Today\'s entries: recordedAt between from and to']
  }
}

Table growthMeasurements [note: 'Owner: Epic 5. Read by Epic 4 (pediatrician, Could).'] {
  _id objectid [pk]
  babyId objectid [not null, ref: > babies._id]
  loggedByUserId objectid [not null, ref: > users._id]
  measuredAt date [not null]
  weightGrams int [not null]
  heightCm decimal [not null]
  headCircumferenceCm decimal
  createdAt date
  updatedAt date

  Indexes {
    (babyId, measuredAt)
  }
}

Table milestones [note: 'Owner: Epic 5.'] {
  _id objectid [pk]
  babyId objectid [not null, ref: > babies._id]
  loggedByUserId objectid [not null, ref: > users._id]
  category milestone_category [not null]
  title string [not null, note: 'e.g. "First smile"']
  achievedAt date [not null]
  notes string
  createdAt date
  updatedAt date

  Indexes {
    (babyId, achievedAt)
  }
}

// ───────────────────── Platform: Documents and AI ─────────────────────

Table certificates [note: 'Owner: Documents service. Created by workflow.approveRegistration(). The PDF is generated on download, not stored.'] {
  _id objectid [pk]
  babyId objectid [not null, unique, ref: - babies._id, note: 'One per baby, so approval can safely run twice']
  registrationId objectid [not null, ref: - registrations._id]
  certificateNumber string [not null, unique, note: 'DEMO format']
  jmbg string [not null, note: 'Copy at issue time']
  verificationCode string [not null, unique, note: 'crypto.randomUUID(). QR → /verify/:code shows only valid, document type and issue date.']
  issuedByUserId objectid [not null, ref: > users._id, note: 'The MoI staff member who approved']
  issuedAt date [not null]
  isDemo boolean [not null, default: true]
  createdAt date
  updatedAt date
}

Table aiSuggestions [note: 'Owner: AI service. AI suggests, a human decides, the action is logged.'] {
  _id objectid [pk]
  kind ai_suggestion_kind [not null]
  registrationId objectid [not null, ref: > registrations._id]
  provider string [not null, note: '"mock" until the provider is chosen']
  model string
  flags array [not null, default: `[]`, note: 'EMBEDDED ai_flags']
  aiAvailable boolean [not null, note: 'false = AI failed; only rule flags shown']
  requestedByUserId objectid [not null, ref: > users._id]
  createdAt date
  updatedAt date

  Indexes {
    registrationId
  }
}

Table ai_flags [note: 'EMBEDDED array aiSuggestions.flags. Not a collection.'] {
  aiSuggestionId objectid [ref: > aiSuggestions._id, note: 'The suggestion that holds the array']
  field string [not null, note: 'e.g. "proposedLastName"']
  message string [not null, note: 'One plain-English sentence']
  source ai_flag_source [not null]
  decision ai_flag_decision [not null, default: 'pending']
  decidedByUserId objectid [ref: > users._id]
  decidedAt date
}

// ───────────────────── Platform: Notifications ─────────────────────

Table notifications [note: 'Owner: Notifications service. Messages never contain a JMBG or medical details. Email and SMS are simulated (Demo inbox).'] {
  _id objectid [pk]
  recipientUserId objectid [not null, ref: > users._id]
  babyId objectid [ref: > babies._id]
  type string [not null, note: 'e.g. "registration.approved", "vaccination.reminder"']
  title string [not null]
  message string [not null]
  link string [note: 'Client route, e.g. "/babies/:id"']
  channels_inApp boolean [not null, default: true, note: 'channels.inApp']
  channels_email boolean [not null, default: true, note: 'channels.email – shown in the Demo inbox']
  channels_sms boolean [not null, default: true, note: 'channels.sms – shown in the Demo inbox']
  readAt date
  createdAt date
  updatedAt date

  Indexes {
    (recipientUserId, createdAt)
  }
}

// ───────────────────── Groups (one colour each in dbdiagram) ─────────────────────

TableGroup platform_auth_audit [note: 'Auth service owner (Epic 1 developer)'] {
  institutions
  users
  auditLogs
}

TableGroup epic1_hospital [note: 'Epic 1: Hospital and birth records'] {
  babies
  parent_info
  baby_authorized_users
}

TableGroup epic2_registration_workflow [note: 'Epic 2 + Workflow service'] {
  registrations
  status_change
}

TableGroup epic3_csw_fzo [note: 'Epic 3: CSW and FZO'] {
  cswCases
  insuranceRecords
}

TableGroup epic4_health [note: 'Epic 4: Dashboard, BabyHealth, pediatrician'] {
  medicalRecords
  vaccinations
  appointments
}

TableGroup epic5_care [note: 'Epic 5: BabyCare and BabySteps'] {
  diaryEntries
  growthMeasurements
  milestones
}

TableGroup platform_documents_ai [note: 'Documents and AI services (Epic 3 developer)'] {
  certificates
  aiSuggestions
  ai_flags
}

TableGroup platform_notifications [note: 'Notifications service (Epic 4 developer)'] {
  notifications
}
