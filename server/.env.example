# Copy this file to .env and fill in real values. Never commit .env.

# Use YOUR OWN database name at the end (for example /ebeba-marko), so the seed
# script never deletes anyone else's data. The instructor seeds the shared database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ebeba-yourname
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of front-end URLs allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
PORT=3000
# Password for every seeded demo account
SEED_PASSWORD=eBeba-demo-2026
# AI provider: "mock" until the instructor chooses one
AI_PROVIDER=mock
